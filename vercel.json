{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/api/auth/logout",
      "destination": "/api/auth/login?sortir=1",
      "permanent": false
    },
    {
      "source": "/README.md",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/package.json",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/lib/:chemin*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/outils/:chemin*",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' wss://mer.95-170-26-39.sslip.io wss://irc-ws.chat.twitch.tv https://7tv.io https://api.betterttv.net https://api.frankerfacez.com ws://127.0.0.1:* ws://localhost:*; frame-src https://player.twitch.tv https://www.twitch.tv https://www.youtube-nocookie.com https://www.tiktok.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/modeles/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/polices/v(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/js/three-r(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/musique/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/son/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/videos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
